/* 全局样式 - CSS变量 */
page {
  --primary: #E07B4C;
  --primary-light: #E89A6E;
  --primary-lighter: #F2C2A1;
  --bg-page: #F8F6F3;
  --bg-card: #FFFFFF;
  --text-primary: #2D2D2D;
  --text-secondary: #666666;
  --text-hint: #999999;
  --color-danger: #FF4D4F;
  --color-success: #52C41A;
  --color-info: #1890FF;
  --radius-lg: 24rpx;
  --radius-md: 16rpx;
  --radius-sm: 12rpx;
  --shadow-card: 0 4rpx 24rpx rgba(0, 0, 0, 0.06);

  font-family: 'PingFang SC', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 28rpx;
  color: var(--text-primary);
  background-color: var(--bg-page);
  box-sizing: border-box;
}

view, text, image {
  box-sizing: border-box;
}

/* 通用flex布局 */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-1 {
  flex: 1;
}

/* 安全区域 */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
