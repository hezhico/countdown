<view class="page">
  <!-- 版式 -->
  <view class="panel">
    <view class="panel-head">
      <text class="panel-title">版式</text>
      <text class="panel-meta">{{cols}} × {{rows}} · {{need}} 张</text>
    </view>

    <view class="layout-row">
      <view
        wx:for="{{presets}}"
        wx:key="key"
        class="layout-chip {{layoutKey == item.key ? 'active' : ''}}"
        data-key="{{item.key}}"
        data-rows="{{item.rows}}"
        data-cols="{{item.cols}}"
        bindtap="onPickLayout"
      >{{item.label}}</view>
      <view
        class="layout-chip {{layoutKey == 'custom' ? 'active' : ''}}"
        bindtap="onPickCustom"
      >自定义</view>
    </view>

    <!-- 自定义网格：行列各 1~5 -->
    <view wx:if="{{layoutKey == 'custom'}}" class="stepper-row">
      <view class="stepper">
        <text class="stepper-label">列</text>
        <view class="stepper-btn {{cols == 1 ? 'off' : ''}}" data-field="cols" data-step="-1" bindtap="onGridStep">−</view>
        <text class="stepper-value">{{cols}}</text>
        <view class="stepper-btn {{cols == 5 ? 'off' : ''}}" data-field="cols" data-step="1" bindtap="onGridStep">+</view>
      </view>
      <view class="stepper">
        <text class="stepper-label">行</text>
        <view class="stepper-btn {{rows == 1 ? 'off' : ''}}" data-field="rows" data-step="-1" bindtap="onGridStep">−</view>
        <text class="stepper-value">{{rows}}</text>
        <view class="stepper-btn {{rows == 5 ? 'off' : ''}}" data-field="rows" data-step="1" bindtap="onGridStep">+</view>
      </view>
    </view>
  </view>

  <!-- 拼图板 -->
  <view class="board-card">
    <view class="board-head">
      <text class="board-title">拼图板</text>
      <view class="board-pick" bindtap="choosePhotos" hover-class="bar-btn-hover">＋ 选图</view>
    </view>

    <view id="board" class="board" style="width:{{boardW}}px;gap:{{gap}}px;">
      <view
        wx:for="{{cells}}"
        wx:key="id"
        class="cell {{item.src ? '' : 'cell-empty'}} {{dragging == index ? 'cell-lifted' : ''}} {{targetIdx == index && dragging != index ? 'cell-target' : ''}} {{selected == index ? 'cell-selected' : ''}}"
        style="width:{{cellPx}}px;height:{{cellPx}}px;"
        data-idx="{{index}}"
        bindtouchstart="onTouchStart"
        bindtouchmove="onTouchMove"
        bindtouchend="onTouchEnd"
      >
        <image
          wx:if="{{item.src}}"
          class="cell-img"
          src="{{item.src}}"
          mode="aspectFill"
          style="transform:rotate({{item.rot}}deg);"
        />
        <view wx:else class="cell-plus">＋</view>
      </view>
    </view>

    <view class="board-foot">
      <text class="foot-count">已选 {{filled}}/{{need}} 张</text>
      <text class="foot-tip" wx:if="{{filled == 0}}">点空格或下方「选择照片」开始</text>
      <text class="foot-tip" wx:elif="{{filled < need}}">点空格继续补选</text>
      <text class="foot-tip" wx:else>长按拖动换位 · 点击选中可旋转</text>
    </view>
  </view>

  <!-- 生成结果 -->
  <view wx:if="{{resultPath}}" class="result-card">
    <image class="result-thumb" src="{{resultPath}}" mode="aspectFill" />
    <view class="result-info">
      <text class="result-title">拼图已生成</text>
      <text class="result-sub">保存到相册，或直接转发给好友</text>
      <view class="result-actions">
        <view class="mini-btn primary" bindtap="saveToAlbum">保存到相册</view>
        <view class="mini-btn" bindtap="onShare">转发好友</view>
      </view>
    </view>
  </view>

  <!-- 选中格子时的旋转工具：浮在底栏上方，不挤掉选图/生成入口 -->
  <view wx:if="{{selected >= 0}}" class="rotate-pill">
    <text class="sel-index">第 {{selected + 1}} 格</text>
    <view class="rot-btn" data-step="-90" bindtap="onRotate" hover-class="rot-btn-hover">↺ 左转</view>
    <view class="rot-btn" data-step="90" bindtap="onRotate" hover-class="rot-btn-hover">↻ 右转</view>
    <view class="done-btn" bindtap="onClearSelect">完成</view>
  </view>

  <!-- 底部操作栏：选图 + 生成，始终可见 -->
  <view class="bottom-bar">
    <view class="bar-btn bar-btn-outline" bindtap="choosePhotos" hover-class="bar-btn-hover">{{pickLabel}}</view>
    <view class="bar-btn primary {{filled < need ? 'bar-btn-dim' : ''}}" bindtap="compose" hover-class="bar-btn-hover">生成拼图</view>
  </view>

  <!-- 拖动浮层 -->
  <view
    wx:if="{{dragging >= 0}}"
    class="drag-ghost"
    style="left:{{ghostX}}px;top:{{ghostY}}px;width:{{cellPx}}px;height:{{cellPx}}px;"
  >
    <image class="drag-ghost-img" src="{{dragSrc}}" mode="aspectFill" style="transform:rotate({{dragRot}}deg);" />
  </view>

  <!-- 离屏合成画布 -->
  <canvas type="2d" id="compose" class="hidden-canvas"></canvas>
</view>
