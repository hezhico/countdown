.page {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: 180rpx;
}

/* Tab 切换 */
.tabs {
  display: flex;
  flex-direction: row;
  padding: 24rpx 32rpx 0;
  gap: 40rpx;
  background: var(--bg-page);
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding-bottom: 12rpx;
  position: relative;
}

.tab-text {
  font-size: 30rpx;
  color: var(--text-hint);
  font-weight: 500;
  transition: color 0.2s;
}

.tab-active .tab-text {
  color: var(--text-primary);
  font-weight: 600;
}

.tab-line {
  width: 40rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: linear-gradient(90deg, #FF6B35, #FFA559);
}

/* 列表容器 */
.list-container {
  padding: 24rpx 32rpx 0;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  gap: 20rpx;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-hint);
}

.empty-btn {
  margin-top: 16rpx;
  padding: 16rpx 48rpx;
  background: linear-gradient(135deg, #FF6B35, #FFA559);
  border-radius: 40rpx;
}

.empty-btn-text {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 500;
}

/* 悬浮添加按钮 */
.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 100px;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF6B35, #FFA559);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(255, 107, 53, 0.4);
  z-index: 100;
  font-size: 60rpx;
  color: #FFFFFF;
  font-weight: 200;
}
