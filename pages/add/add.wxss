.page {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: 180rpx;
}

/* 表单 */
.form {
  padding: 32rpx;
}

.form-group {
  margin-bottom: 40rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 16rpx;
  display: block;
}

.input-wrapper {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 0 28rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  box-shadow: var(--shadow-card);
}

.form-input {
  flex: 1;
  font-size: 30rpx;
  color: var(--text-primary);
  height: 96rpx;
}

.input-placeholder {
  color: var(--text-hint);
  font-size: 28rpx;
}

/* 日期选择 */
.date-wrapper {
  justify-content: space-between;
}

.date-value {
  font-size: 30rpx;
  color: var(--text-primary);
}

.date-placeholder {
  font-size: 28rpx;
  color: var(--text-hint);
}

.date-arrow {
  font-size: 36rpx;
  color: var(--text-hint);
  font-weight: 300;
}

/* 分段选择器 - 公历/农历 */
.segment-control {
  display: flex;
  flex-direction: row;
  background: var(--bg-card);
  border-radius: 16rpx;
  padding: 6rpx;
  box-shadow: var(--shadow-card);
}

.segment-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  border-radius: 12rpx;
  transition: all 0.3s ease;
}

.segment-active {
  background: linear-gradient(135deg, #FF6B35, #FFA559);
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 53, 0.3);
}

.segment-text {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-secondary);
}

.segment-active .segment-text {
  color: #FFFFFF;
  font-weight: 600;
}

/* 农历选择器行 */
.lunar-picker-row {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
}

.lunar-picker-item {
  flex: 1;
  justify-content: space-between;
}

/* 每年重复开关行 */
.switch-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  padding: 24rpx 28rpx;
  box-shadow: var(--shadow-card);
}

.switch-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.switch-desc {
  font-size: 24rpx;
  color: var(--text-hint);
}

.repeat-switch {
  transform: scale(0.85);
}

.subscribe-switch {
  transform: scale(0.85);
}

.subscribe-tips {
  margin-top: 12rpx;
  padding: 12rpx 20rpx;
  background: rgba(19, 194, 194, 0.08);
  border-radius: var(--radius-sm);
  border-left: 6rpx solid #13C2C2;
}

.subscribe-tip-text {
  font-size: 22rpx;
  color: #13C2C2;
}

/* 颜色选择 */
.color-list {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 20rpx;
}

.color-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--radius-md);
  background: var(--bg-card);
  box-shadow: var(--shadow-card);
  position: relative;
  min-width: 100rpx;
  transition: transform 0.2s, box-shadow 0.2s;
}

.color-active {
  transform: scale(1.05);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.12);
}

.color-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
}

.color-label {
  font-size: 22rpx;
  color: var(--text-secondary);
}

.color-check {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: var(--color-success);
  color: #FFFFFF;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 预览卡片 */
.preview-card {
  display: flex;
  flex-direction: row;
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card);
  overflow: hidden;
  min-height: 120rpx;
}

.preview-bar {
  width: 8rpx;
  flex-shrink: 0;
}

.preview-body {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
}

.preview-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.preview-name-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
}

.preview-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.preview-badge {
  background: linear-gradient(135deg, #FF6B35, #FFA559);
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}

.preview-badge-lunar {
  background: linear-gradient(135deg, #13C2C2, #36CFC9);
}

.preview-badge-text {
  font-size: 20rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.preview-date {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.preview-days {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 4rpx;
}

.preview-days-num {
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1;
}

.preview-days-label {
  font-size: 22rpx;
  color: var(--text-hint);
}

/* 保存按钮 */
.save-area {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx;
  background: var(--bg-page);
}

.save-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #FF6B35, #FFA559);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 53, 0.35);
}

.save-btn-disabled {
  opacity: 0.5;
  box-shadow: none;
}

.save-btn-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
}
